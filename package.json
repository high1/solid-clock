{
  "dependencies": {
    "solid-js": "1.9.18"
  },
  "description": "Solid-js clock, inspired by sauron clock, credits to voby",
  "devDependencies": {
    "@e18e/eslint-plugin": "0.8.1",
    "@eslint/css": "2.0.1",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "8.0.3",
    "@html-eslint/eslint-plugin": "0.68.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "25.9.9",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-solid": "0.19.0",
    "eslint-plugin-yml": "3.10.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vite-plugin-checker": "0.14.5",
    "vite-plugin-solid": "2.11.15",
    "vitest": "5.1.0",
    "vitest-browser-solid": "1.0.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": "12.18.0"
    },
    "runtime": {
      "name": "node",
      "onFail": "warn",
      "version": "26.13.0"
    }
  },
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx"
    ]
  },
  "keywords": [
    "solid-js",
    "clock",
    "svg"
  ],
  "license": "MIT",
  "name": "solid-clock",
  "repository": {
    "type": "git",
    "url": "https://github.com/high1/solid-clock.git"
  },
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "playwright": "playwright install --only-shell chromium",
    "preview": "vite preview",
    "start": "vite",
    "test": "vitest run"
  },
  "type": "module",
  "version": "1.0.0"
}
