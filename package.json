{
  "dependencies": {
    "@solidjs/web": "2.0.4",
    "solid-js": "2.0.4"
  },
  "description": "Solid-js clock, inspired by sauron clock, credits to voby",
  "devDependencies": {
    "@e18e/eslint-plugin": "0.8.1",
    "@eslint/css": "2.0.1",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "9.0.0",
    "@html-eslint/eslint-plugin": "0.69.0",
    "@solidjs/vite-plugin": "3.0.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "26.6.10",
    "@vitest/browser-playwright": "5.1.2",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-perfectionist": "5.14.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-solid": "0.20.1",
    "eslint-plugin-yml": "3.10.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vite-plugin-checker": "1.1.0",
    "vitest": "5.1.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": "12.23.0"
    },
    "runtime": {
      "name": "node",
      "onFail": "download",
      "version": "26.13.1"
    }
  },
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx"
    ],
    "#/eslint-rule": "./eslint-rule.ts"
  },
  "keywords": [
    "solid-js",
    "clock",
    "svg"
  ],
  "license": "MIT",
  "name": "solid-clock",
  "repository": {
    "type": "git",
    "url": "https://github.com/high1/solid-clock.git"
  },
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "ESLINT_FLAGS=unstable_native_nodejs_ts_config eslint . --max-warnings 0",
    "playwright": "playwright install --only-shell chromium",
    "preview": "vite preview",
    "start": "vite",
    "test": "vitest run"
  },
  "type": "module",
  "version": "1.0.0"
}
